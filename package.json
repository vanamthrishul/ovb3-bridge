{
  "name": "ovb3-bridge",
  "version": "0.3.3",
  "description": "OVB3 (Oracle Visual Builder Bridge): MCP server + CLI + Claude Code plugin for driving Oracle Visual Builder Studio (VBS) / VBCS app development from Claude: read, search and edit artifacts, audit service calls across apps, git, Oracle's build/audit tasks, VB Studio CI jobs, and standalone-VBCS data export/import.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "oracle",
    "visual-builder",
    "vbcs",
    "vb-studio",
    "claude",
    "claude-code",
    "claude-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanamthrishul/ovb3-bridge.git"
  },
  "homepage": "https://github.com/vanamthrishul/ovb3-bridge#readme",
  "bugs": {
    "url": "https://github.com/vanamthrishul/ovb3-bridge/issues"
  },
  "bin": {
    "ovb3": "dist/cli.js",
    "ovb3-bridge": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "simple-git": "^3.25.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
