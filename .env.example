# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Workspace (instance-wide, not a single app) ----------------------------
# The toolkit targets a whole VBS instance: one instance hosts multiple VB
# Studio projects, each its own git repo, each repo potentially holding
# several VBCS web apps under webApps/. Tools take a repo + app per call;
# these vars just seed local discovery/defaults.

# Absolute path to a directory containing local checkouts of one or more VB
# Studio project repos (e.g. workspace/<project-repo-a>/, workspace/<project-repo-b>/).
# listRepos()/listApps() discover what's available under here.
VBS_WORKSPACE_DIR=

# Optional: absolute path to a single repo checkout, used as the fallback
# when a tool call doesn't specify a repo. Only useful if you're mostly
# working against one project.
VBCS_REPO_PATH=

# Optional: default VBCS web app name (webApps/<name>) used when a tool call
# doesn't specify one.
VBCS_APP_NAME=

# --- VB Studio git remote ---------------------------------------------------
# HTTPS remote URL for the VB Studio-backed git repo (used by git helper tools
# for commit/push/pull). Example: https://<team>.visualbuilder.<region>.ocp.oraclecloud.com/... /scm/<project>/<repo>.git
# Multi-repo setups pass the remote per call instead; this is just a default.
VBSTUDIO_GIT_REMOTE_URL=

# Git author identity used for commits made by the toolkit.
VBSTUDIO_GIT_USER_NAME=
VBSTUDIO_GIT_USER_EMAIL=

# --- Auth (IDCS / Oracle Cloud) --------------------------------------------
# Never paste raw credentials into a Claude conversation. Fill these in
# directly in your local .env file.

# Basic auth for git operations (VB Studio personal access token recommended
# over a raw password).
VBSTUDIO_GIT_USERNAME=
VBSTUDIO_GIT_TOKEN=

# IDCS OAuth client credentials, for REST API calls (VBSTUDIO_API_BASE_URL
# below). Leave blank until a dev instance + credentials are provided.
IDCS_CLIENT_ID=
IDCS_CLIENT_SECRET=
IDCS_TOKEN_URL=

# --- VB Studio / VBCS REST API ---------------------------------------------
# Base URL for the VB Studio REST API (CI/CD builds, environments, etc).
# TODO: confirm actual base path/shape against a real dev instance before use.
VBSTUDIO_API_BASE_URL=

# Name of the target VBCS runtime environment (e.g. dev/test/prod), if the
# REST API needs it for deploy/build-target calls.
VBCS_ENVIRONMENT_NAME=

# --- Standalone VBCS instance REST API --------------------------------------
# For VBCS apps NOT backed by a VB Studio project (no git remote). Confirmed
# against docs.oracle.com/en/cloud/paas/app-builder-cloud/vb-rest-apis/.
# Auth here is IDCS username/password via POST {VBCS_BASE_URL}/ic/builder/public/token
# — distinct from the IDCS_CLIENT_ID/SECRET vars above, which are for VB Studio's REST API.
# Normally populated by running /link, not by hand — but IDCS_USERNAME/PASSWORD
# are secrets /link will never write; fill those in yourself.

# Base URL of the standalone VBCS instance.
VBCS_BASE_URL=

# IDCS/OCI IAM username + password used to obtain a design-time API token.
VBCS_IDCS_USERNAME=
VBCS_IDCS_PASSWORD=

# --- grunt-vb-build / grunt-vb-audit -----------------------------------------
# These are installed separately from a private Oracle CDN tarball feed (not
# public npm). See README for the manual setup step. Nothing to configure
# here unless your feed needs an auth token.
VB_BUILD_NPM_REGISTRY=

# Your org's Component Exchange URL. Confirmed required (not optional) by
# actually running vb-build/vb-audit against a real app with shared
# components — without it vb-build fails outright ("Missing mandatory
# component exchange URL") and vb-audit can't resolve component references.
# Example shape from Oracle's own error message: https://exchange.oraclecorp.com/api/0.2.0
# Leave blank if you don't know it yet — run_build/run_audit will just
# surface Oracle's own clear error instead of silently guessing a value.
VB_BUILD_COMPONENT_EXCHANGE_URL=
