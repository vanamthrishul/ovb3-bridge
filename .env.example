# OVB3 configuration. Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Where this file is read from (highest priority first):
#   1. real environment variables (e.g. Claude Code plugin settings)
#   2. ./.env in the directory you run from
#   3. this install's own config: <clone>/.env for a git clone, ~/.ovb3/.env for an npm/npx install
#      (override the location with OVB3_ENV_FILE)
#
# Not sure what's missing?  Run `ovb3 doctor` — it checks everything below and
# tells you the exact fix. Never paste real credentials into a Claude conversation.

# --- Workspace --------------------------------------------------------------
# One folder holding local git checkouts of your VB Studio project repos
# (<workspace>/<repo-a>/, <workspace>/<repo-b>/ ...). Each repo can hold several
# VBCS web apps under webApps/. Tools take a repo + app per call; list_repos /
# list_apps discover what's here.
VBS_WORKSPACE_DIR=

# Optional single-repo / single-app defaults used when a call doesn't name one.
VBCS_REPO_PATH=
VBCS_APP_NAME=

# --- VB Studio git (clone / pull / push) ------------------------------------
# HTTPS credentials. Sent as a scoped Authorization header — never embedded in
# URLs, logs or .git/config — so clone/pull/push never stop at a hidden prompt.
# Use a VB Studio personal access token as the token. Tokens expire: if git
# starts failing with "Authentication failed", generate a new one.
VBSTUDIO_GIT_USERNAME=
VBSTUDIO_GIT_TOKEN=

# Optional default remote (used to derive the CI API base when no repo is given).
# Shape: https://<host>/<org>/s/<org>_<project>/scm/<repo>.git
VBSTUDIO_GIT_REMOTE_URL=

# Author identity for commits the toolkit makes (falls back to your git config).
VBSTUDIO_GIT_USER_NAME=
VBSTUDIO_GIT_USER_EMAIL=

# --- Build / audit (grunt-vb-build, grunt-vb-audit) -------------------------
# Run `setup_build_tools` (or `npm install` in the repo) once per checkout; VB
# Studio projects pin Oracle's tarballs in their own package.json.
#
# Your org's Component Exchange URL. Needed whenever an app uses web components
# (most do) — without it vb-build fails with "Missing mandatory component
# exchange URL". Find it in VB Studio -> Tenant Settings -> Component Exchange.
# A private exchange looks like:
#   https://<vbs-host>/<org>/s/<org>_<project>/compcatalog/0.2.0
VB_BUILD_COMPONENT_EXCHANGE_URL=
# Only if your exchange requires them (an access token wins over user/password).
VB_BUILD_CE_USERNAME=
VB_BUILD_CE_PASSWORD=
VB_BUILD_CE_ACCESS_TOKEN=

# --- VB Studio CI (vbstudio_trigger_build / status / params) ----------------
# The API base is derived from the repo's git remote automatically. Set this
# only to override it: https://<server>/<org-id>/rest/<org-id_project-id>
VBSTUDIO_API_BASE_URL=
# Personal access token (bearer). If unset, VBSTUDIO_API_USERNAME/PASSWORD are
# used as Basic auth, and if those are unset too, the git credentials above.
VBSTUDIO_API_TOKEN=
VBSTUDIO_API_USERNAME=
VBSTUDIO_API_PASSWORD=

# --- Standalone VBCS instance (apps with NO VB Studio project) ---------------
# Bare host only — do NOT include /ic/builder. Normally set by /link or `ovb3 init`;
# the username/password are secrets those flows never write — fill them in yourself.
VBCS_BASE_URL=
VBCS_IDCS_USERNAME=
VBCS_IDCS_PASSWORD=

# --- Tuning (all optional) ----------------------------------------------------
# Stop a stalled git operation after this many ms (default 120000).
OVB3_GIT_TIMEOUT_MS=
# Stop a build/audit/npm-install after this many ms (default 900000 = 15 min).
OVB3_BUILD_TIMEOUT_MS=
# Read/write config from this file instead of the default location.
OVB3_ENV_FILE=
